# fbxtool sample: a square pyramid with two materials
mtllib pyramid.mtl
o Pyramid
v  0.0  1.5  0.0
v -1.0  0.0  1.0
v  1.0  0.0  1.0
v  1.0  0.0 -1.0
v -1.0  0.0 -1.0
vt 0.5 1.0
vt 0.0 0.0
vt 1.0 0.0
vt 0.5 0.5
vn  0.000  0.555  0.832
vn  0.832  0.555  0.000
vn  0.000  0.555 -0.832
vn -0.832  0.555  0.000
vn  0.000 -1.000  0.000
usemtl Sides
f 1/1/1 2/2/1 3/3/1
f 1/1/2 3/2/2 4/3/2
f 1/1/3 4/2/3 5/3/3
f 1/1/4 5/2/4 2/3/4
usemtl Base
f 2/4/5 5/4/5 4/4/5 3/4/5
